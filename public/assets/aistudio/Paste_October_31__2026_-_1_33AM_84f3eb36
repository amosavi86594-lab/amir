          savedPlans: ['np-diet-02'],
        };
  });

  useEffect(() => {
    if (user) {
      localStorage.setItem('noorplaner_user', JSON.stringify(user));
    } else {
      localStorage.removeItem('noorplaner_user');
    }
  }, [user]);

  const loginAsDemoUser = () => {
